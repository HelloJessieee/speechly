# Copy this file to .env and fill in your values. .env is ignored by git.
#
# Server-side only. Do NOT rename these with a VITE_ prefix: Vite bundles every
# VITE_* variable into the browser code, which would publish your key.

# Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Model used by future Claude features.
CLAUDE_MODEL=claude-opus-5-5
